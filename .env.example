# Copie para .env.local e preencha. .env* e ignorado pelo git.

# Bot do BotFather.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Segredo do webhook. Gere com:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
TELEGRAM_WEBHOOK_SECRET_TOKEN=

# IDs de usuario do Telegram autorizados. Vazio = qualquer um fala com o bot.
TELEGRAM_ALLOWED_USER_IDS=

# polling = sem webhook (inerte hoje: o chatSdkChannel do eve so serve webhook).
# webhook = producao e dev via tunel.
TELEGRAM_MODE=webhook

# Chave da OpenAI.
OPENAI_API_KEY=

# Modelo do agente e da transcricao de voz.
AGENT_MODEL=gpt-5-mini
TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# Hosts que o fetch_audio pode baixar. Vazio = o bot recusa toda URL.
# Um dominio ja cobre os subdominios: youtube.com aceita www.youtube.com.
AUDIO_ALLOWED_HOSTS=

# CDNs extras que o sandbox pode alcancar. So preencha se adicionar uma fonte
# cujo CDN nao esteja no mapa de agent/lib/sources.ts.
AUDIO_EXTRA_EGRESS_HOSTS=
