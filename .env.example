# Telegram bot credentials.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET_TOKEN=

# Telegram user IDs allowed to use the bot. Empty allows anyone.
TELEGRAM_ALLOWED_USER_IDS=

# Inbound transport: webhook or polling.
TELEGRAM_MODE=webhook

# OpenAI credentials and models.
OPENAI_API_KEY=
AGENT_MODEL=gpt-5-mini
TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# Hosts the bot may download from. Empty rejects every URL.
AUDIO_ALLOWED_HOSTS=

# Additional hosts the sandbox may reach.
AUDIO_EXTRA_EGRESS_HOSTS=
