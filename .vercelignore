# Kept out of the deployment upload. Vercel installs dependencies and builds
# from source, so anything reproducible there is dead weight here.

# Reinstalled on Vercel from package-lock.json.
node_modules

# Secrets come from the Vercel project environment, never from a file.
.env*

# eve's local state: builds, sandbox cache, traces and dev logs.
.eve

# Build output, regenerated by the Vercel build.
.next
.output
.nitro
dist
